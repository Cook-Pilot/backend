# VPS 배포용. cp .env.example .env 후 값을 채운다.
# .env 는 절대 커밋하지 않는다 (.gitignore 등록됨).

# --- PostgreSQL ---
POSTGRES_DB=cookpilot
POSTGRES_USER=cookpilot
# 반드시 교체. 예: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# --- 앱 ---
APP_PORT=8080

# --- F-11 Gemini 추천 설명 ---
# 베타에서는 Google AI Studio의 Gemini Developer API 무료 티어 키를 사용한다.
# 키가 없거나 무료 티어 호출에 실패하면 추천 수치는 유지하고 추천 fallback을 사용한다.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Watchtower ---
# GHCR 폴링 주기(초). 기본 300 = 5분. 너무 짧게 잡으면 레지스트리 rate limit 위험.
WATCHTOWER_INTERVAL=300
