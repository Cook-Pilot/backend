# VPS 배포용. cp .env.example .env 후 값을 채운다.
# .env 는 절대 커밋하지 않는다 (.gitignore 등록됨).

# --- PostgreSQL ---
POSTGRES_DB=cookpilot
POSTGRES_USER=cookpilot
# 반드시 교체. 예: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# --- 앱 ---
APP_PORT=8080

# --- F-11 Gemini 추천 설명 ---
# 베타에서는 Google AI Studio의 Gemini Developer API 무료 티어 키를 사용한다.
# 키가 없거나 무료 티어 호출에 실패하면 추천 수치는 유지하고 추천 fallback을 사용한다.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- 조리 중 AI 피드백 (Spring AI) ---
# 위 GEMINI_API_KEY 를 그대로 공유한다(같은 Google AI Studio 키).
# none = LLM 을 호출하지 않고 목 응답을 반환한다. 켜려면 google-genai.
# none 이 아닌데 키가 비어 있으면 기동이 실패한다(Incomplete Google GenAI configuration).
AI_CHAT_PROVIDER=none
AI_CHAT_MODEL=gemini-3.5-flash

# --- 소셜 로그인 ---
# 세션 토큰 서명 키. **필수** — 비워 두면 컨테이너가 아예 뜨지 않는다.
#   openssl rand -base64 48
# 이 값이 바뀌면 발급된 모든 토큰이 무효가 된다(= 전원 재로그인).
JWT_SECRET=CHANGE_ME
# 안드로이드·iOS·웹 클라이언트 ID 를 쉼표로 나열한다. 비우면 구글 로그인이 거부된다.
GOOGLE_CLIENT_IDS=
# 개발자 로그인(로그인 화면 7번 탭)에 쓰는 시크릿. 비우면 기능이 꺼진다.
DEV_LOGIN_SECRET=

# --- 리뷰 사진 업로드(S3) ---
# 운영 서버(EC2)에서는 아래 버킷을 채운다:
#   PHOTOS_BUCKET=cookpilot-photos-167403240280
# 비워두면 업로드 없이 목 URL 을 돌려준다 — 로컬은 AWS 자격증명이 없으므로 비운 채로 둔다.
# 자격증명은 여기 넣지 않는다 — EC2 인스턴스 역할을 SDK 가 자동으로 집는다.
PHOTOS_BUCKET=
PHOTOS_REGION=ap-northeast-2
